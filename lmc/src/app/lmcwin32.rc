#include <windows.h>
#include "../core/definitions.h"

IDI_MAIN_ICON   ICON    DISCARDABLE "lmc.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,4,0,1
PRODUCTVERSION  1,4,0,1
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef DEBUG
FILEFLAGS       VER_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "Comments",         "\0"
            VALUE "CompanyName",      "LAN Messenger\0"
            VALUE "FileDescription",  "LAN Messenger\0"
            VALUE "FileVersion",      IDA_VERSION "\0"
            VALUE "InternalName",     "lanmsngr\0"
            VALUE "LegalCopyright",   "Copyright (C) 2010-2026 Qualia Digital Solutions.\0"
            VALUE "OriginalFilename", "lmc.exe\0"
            VALUE "ProductName",      "LAN Messenger\0"
            VALUE "ProductVersion",   IDA_VERSION "\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
